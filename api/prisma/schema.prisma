// Prisma Schema for Test Management Platform
// Sprint 1: Users, Auth, Projects, Members

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum SystemRole {
  ADMIN
  USER
}

enum ProjectRole {
  QA_LEAD
  TESTER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseStatus {
  DRAFT
  READY
  DEPRECATED
}

enum TestRunStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TestExecutionStatus {
  UNTESTED
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
  CLOSED
  REOPENED
}

enum NotificationType {
  TEST_RUN_ASSIGNED
  TEST_RUN_REVIEW_REQUESTED
  TEST_RUN_REWORK_REQUESTED
  TEST_RUN_COMPLETED
  BUG_ASSIGNED
  BUG_STATUS_CHANGED
  SYSTEM
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  avatarUrl    String?    @db.Text @map("avatar_url")
  systemRole   SystemRole @default(USER) @map("system_role")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens     RefreshToken[]
  projectMembers    ProjectMember[]
  createdProjects   Project[]
  createdTestCases  TestCase[]
  testCaseHistories TestCaseHistory[]
  assignedTestRuns  TestRun[]         @relation("AssignedTestRuns")
  createdTestRuns   TestRun[]         @relation("CreatedTestRuns")
  executedTests     TestExecution[]
  createdBugs       Bug[]             @relation("CreatedBugs")
  assignedBugs      Bug[]             @relation("AssignedBugs")
  notifications     Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  testCaseSeq Int           @default(0) @map("test_case_seq")
  bugSeq      Int           @default(0) @map("bug_seq")
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy     User            @relation(fields: [createdById], references: [id])
  members       ProjectMember[]
  testSuites    TestSuite[]
  testCases     TestCase[]
  testRuns      TestRun[]
  bugs          Bug[]
  notifications Notification[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  userId    String      @map("user_id")
  role      ProjectRole
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ─────────────────────────────────────────
// EMAIL VERIFICATION (OTP REGISTRATION)
// ─────────────────────────────────────────

model EmailVerification {
  id           String   @id @default(cuid())
  email        String
  otpHash      String   @map("otp_hash")
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  attempts     Int      @default(0)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("email_verifications")
}

// ─────────────────────────────────────────
// PASSWORD RESET (OTP FORGOT PASSWORD)
// ─────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

// ─────────────────────────────────────────
// TEST SUITES (SPRINT 2)
// ─────────────────────────────────────────

model TestSuite {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String
  description String?  @db.Text
  parentId    String?  @map("parent_id")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    TestSuite?  @relation("SuiteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  TestSuite[] @relation("SuiteHierarchy")
  testCases TestCase[]

  @@index([projectId])
  @@index([parentId])
  @@map("test_suites")
}

// ─────────────────────────────────────────
// TEST CASES (SPRINT 2)
// ─────────────────────────────────────────

model TestCase {
  id            String           @id @default(cuid())
  projectId     String           @map("project_id")
  suiteId       String?          @map("suite_id")
  code          String           // Ví dụ: TC-1, TC-2...
  title         String
  description   String?          @db.Text
  preconditions String?          @db.Text
  steps         Json             @default("[]") // [{stepNumber: 1, action: "...", expectedResult: "..."}]
  priority      TestCasePriority @default(MEDIUM)
  status        TestCaseStatus   @default(DRAFT)
  tags          Json             @default("[]")
  order         Int              @default(0)
  version       Int              @default(1)
  createdById   String           @map("created_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite      TestSuite?        @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  createdBy  User              @relation(fields: [createdById], references: [id])
  histories  TestCaseHistory[]
  executions TestExecution[]
  bugs       Bug[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([suiteId])
  @@index([priority])
  @@index([status])
  @@map("test_cases")
}

// ─────────────────────────────────────────
// TEST CASE HISTORIES / VERSIONING (SPRINT 2)
// ─────────────────────────────────────────

model TestCaseHistory {
  id            String           @id @default(cuid())
  testCaseId    String           @map("test_case_id")
  version       Int
  title         String
  description   String?          @db.Text
  preconditions String?          @db.Text
  steps         Json             @default("[]")
  priority      TestCasePriority
  status        TestCaseStatus
  tags          Json             @default("[]")
  changedById   String           @map("changed_by_id")
  changeReason  String?          @db.Text @map("change_reason")
  createdAt     DateTime         @default(now()) @map("created_at")

  testCase  TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@unique([testCaseId, version])
  @@index([testCaseId])
  @@map("test_case_histories")
}

// ─────────────────────────────────────────
// TEST RUNS & EXECUTIONS (SPRINT 3)
// ─────────────────────────────────────────

model TestRun {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  parentRunId  String?       @map("parent_run_id")
  name         String
  description  String?       @db.Text
  status       TestRunStatus @default(OPEN)
  createdById  String        @map("created_by_id")
  assignedToId String?       @map("assigned_to_id")
  startedAt    DateTime?     @map("started_at")
  completedAt  DateTime?     @map("completed_at")
  reworkReason String?       @db.Text @map("rework_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentRun  TestRun?        @relation("TestRunRetests", fields: [parentRunId], references: [id], onDelete: SetNull)
  retests    TestRun[]       @relation("TestRunRetests")
  createdBy  User            @relation("CreatedTestRuns", fields: [createdById], references: [id])
  assignedTo User?           @relation("AssignedTestRuns", fields: [assignedToId], references: [id], onDelete: SetNull)
  executions TestExecution[]

  @@index([projectId])
  @@index([parentRunId])
  @@index([status])
  @@index([assignedToId])
  @@map("test_runs")
}

model TestExecution {
  id                    String              @id @default(cuid())
  testRunId             String              @map("test_run_id")
  testCaseId            String?             @map("test_case_id")
  // Snapshot data of Test Case at time of Run creation (frozen history)
  testCaseCode          String              @map("test_case_code")
  testCaseTitle         String              @map("test_case_title")
  testCasePreconditions String?             @db.Text @map("test_case_preconditions")
  testCaseSteps         Json                @default("[]") @map("test_case_steps")
  testCasePriority      TestCasePriority    @default(MEDIUM) @map("test_case_priority")
  testCaseVersion       Int                 @default(1) @map("test_case_version")
  // Execution result
  status                TestExecutionStatus @default(UNTESTED)
  actualResult          String?             @db.Text @map("actual_result")
  stepResults           Json?               @map("step_results")
  attachments           Json                @default("[]")
  executedById          String?             @map("executed_by_id")
  executedAt            DateTime?           @map("executed_at")
  executionDurationMs   Int?                @map("execution_duration_ms")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  testRun    TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  executedBy User?     @relation(fields: [executedById], references: [id], onDelete: SetNull)
  bugs       Bug[]

  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@index([status])
  @@index([executedById])
  @@index([testRunId, status])
  @@map("test_executions")
}

// ─────────────────────────────────────────
// BUGS & DEFECTS (SPRINT 3)
// ─────────────────────────────────────────

model Bug {
  id              String      @id @default(cuid())
  projectId       String      @map("project_id")
  testExecutionId String?     @map("test_execution_id")
  testCaseId      String?     @map("test_case_id")
  code            String      // e.g. BUG-1, BUG-2
  title           String
  description     String      @db.Text
  severity        BugSeverity @default(MEDIUM)
  status          BugStatus   @default(OPEN)
  createdById     String      @map("created_by_id")
  assigneeId      String?     @map("assignee_id")
  resolvedAt      DateTime?   @map("resolved_at")
  closedAt        DateTime?   @map("closed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testExecution TestExecution? @relation(fields: [testExecutionId], references: [id], onDelete: SetNull)
  testCase      TestCase?      @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("CreatedBugs", fields: [createdById], references: [id])
  assignee      User?          @relation("AssignedBugs", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId])
  @@index([code])
  @@index([status])
  @@index([severity])
  @@index([assigneeId])
  @@index([testExecutionId])
  @@index([testCaseId])
  @@index([projectId, status])
  @@map("bugs")
}

// ─────────────────────────────────────────
// NOTIFICATIONS (SPRINT 3)
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  projectId String?          @map("project_id")
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  link      String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}


