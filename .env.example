# ======================
# Database
# ======================
POSTGRES_USER=tmp_user
POSTGRES_PASSWORD=tmp_password
POSTGRES_DB=test_management
DATABASE_URL=postgresql://tmp_user:tmp_password@localhost:5432/test_management

# ======================
# API / Backend
# ======================
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_also_long_and_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# Frontend
# ======================
VITE_API_URL=http://localhost:3001

# ======================
# Gemini AI (cho chức năng #18: AI gợi ý test case)
# ======================
GEMINI_API_KEY=

# ======================
# Email (Gửi OTP qua Gmail SMTP)
# ======================
# Hướng dẫn lấy mật khẩu ứng dụng Gmail:
# 1. Bật Xác thực 2 bước trên Google: https://myaccount.google.com/security
# 2. Tạo Mật khẩu ứng dụng (App Password): https://myaccount.google.com/apppasswords
# 3. Điền địa chỉ Gmail vào SMTP_USER và mật khẩu 16 chữ cái vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Test Management Platform" <noreply@testplatform.dev>
